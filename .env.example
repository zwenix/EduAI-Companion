# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Third-party AI Keys
GROQ_API_KEY=

# Alibaba Cloud Model Studio — Qwen 3.8 Max text engine (OpenAI-compatible).
# API key from Model Studio → API-KEY page (sk-ws-... workspace key).
ALIBABA_API_KEY=
# Optional: override the Model Studio OpenAI-compatible base URL
# (defaults to the EduAI Companion workspace endpoint in ap-southeast-1).
# ALIBABA_API_BASE=https://ws-XXXX.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

OCR_SPACE_API_KEY=
ELEVENLABS_API_KEY=
HUGGINGFACE_API_KEY=
REPLICATE_API_TOKEN=
OPENROUTER_API_KEY=

# ─── NVIDIA NIM (build.nvidia.com) ──────────────────────────────────────────
# One key powers BOTH the free Nemotron 3 text engines and the Qwen-Image
# premium image route. Create it at https://build.nvidia.com (starts "nvapi-").
#
# Text engines served from https://integrate.api.nvidia.com/v1 :
#   • nvidia/nemotron-3-ultra-550b-a55b              — Nemotron 3 Ultra (550B-A55B), free NIM endpoint,
#                                                      1M context, flagship CAPS authoring engine
#   • nvidia/nemotron-3.5-lightning-30b-a3b          — Nemotron 3.5 Lightning (30B-A3B), 1M context,
#                                                      high-volume text generation
#   • nvidia/nemotron-3-nano-omni-30b-a3b-reasoning  — Nemotron 3 Nano Omni (30B-A3B) reasoning,
#                                                      256k context, image/audio/video/document input
# Image route: qwen/qwen-image (Qwen-Image premium SA illustrations).
NVIDIA_API_KEY=
# Optional: override the NIM gateway (e.g. a self-hosted NIM microservice).
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

