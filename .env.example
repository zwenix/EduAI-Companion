# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Alibaba Cloud Model Studio — Qwen 3.8 Max text engine (OpenAI-compatible).
# API key from Model Studio → API-KEY page (sk-ws-... workspace key).
ALIBABA_API_KEY=
# Optional: override the Model Studio OpenAI-compatible base URL
# (defaults to the EduAI Companion workspace endpoint in ap-southeast-1).
# ALIBABA_API_BASE=https://ws-XXXX.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# NVIDIA NIM — ALL Nemotron models (text generation) MUST use the FREE NVIDIA
# NIM endpoint (https://integrate.api.nvidia.com/v1). Key from
# https://build.nvidia.com/settings/api-keys. Also used by Qwen-Image (NIM).
NVIDIA_API_KEY=

OCR_SPACE_API_KEY=
ELEVENLABS_API_KEY=
HUGGINGFACE_API_KEY=
REPLICATE_API_TOKEN=

# Web Push (VAPID) — enables push notifications. Generate a pair with:
#   npx web-push generate-vapid-keys
# When unset, /api/notifications/vapid-public-key reports { enabled: false }
# and the client NotificationManager stays silent (no 404s, no errors).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.tld
