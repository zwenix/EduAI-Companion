# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Alibaba Cloud Model Studio — Qwen 3.8 Max text engine (OpenAI-compatible).
# API key from Model Studio → API-KEY page (sk-ws-... workspace key).
ALIBABA_API_KEY=
# Optional: override the Model Studio OpenAI-compatible base URL
# (defaults to the EduAI Companion workspace endpoint in ap-southeast-1).
# ALIBABA_API_BASE=https://ws-XXXX.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# NVIDIA NIM — ALL Nemotron models (text generation) MUST use the FREE NVIDIA
# NIM endpoint (https://integrate.api.nvidia.com/v1). Key from
# https://build.nvidia.com/settings/api-keys.
# NOTE: NVIDIA NIM no longer serves images in this app — the Qwen-Image slugs
# (qwen/qwen-image, qwen/qwen-image-2512) were retired after they started
# answering 404 at the gateway.
NVIDIA_API_KEY=

OCR_SPACE_API_KEY=
ELEVENLABS_API_KEY=

# Hugging Face — free inference token (https://huggingface.co/settings/tokens).
# Powers TWO things:
#   1. FLUX.1-schnell image generation (PRIMARY image engine, free tier).
#   2. Hugging Face TTS / voice engines.
# Without it, images fall through to the keyless Pollinations provider, so the
# app still generates illustrations — they just lose the FLUX quality bump.
HUGGINGFACE_API_KEY=
# Optional: override the FLUX slug (e.g. black-forest-labs/FLUX.1-dev).
# HUGGINGFACE_IMAGE_MODEL=

# Cloudflare Workers AI — OPTIONAL second free backend for the same model
# (@cf/black-forest-labs/flux-1-schnell). The free plan includes 10,000 neurons
# per day (~170 images at 1024x1024/4 steps). Used only when both values are set,
# and only after Hugging Face fails, so it can never make generation slower for
# a healthy deployment.
#   Account ID: Cloudflare dashboard → Workers & Pages → Account ID.
#   API token:  My Profile → API Tokens → Create Token → "Workers AI" → Read.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Pollinations — LAST-RESORT image engine. The anonymous tier needs no key but
# allows roughly 1 image every 45 seconds per IP (HTTP 402 `FREE_LIMIT`); the
# app now detects that instantly and moves on instead of retrying for 90 s.
# A FREE key from https://enter.pollinations.ai removes the per-IP throttle
# (an `sk_` secret key has no IP limit at all) — this is the single best fix
# when teachers see "free limit reached".
# POLLINATIONS_API_KEY=

# OPTIONAL browser-side Hugging Face key. Compiled into the PUBLIC bundle, so
# use a dedicated, rate-limited token — never an account-wide one. Only needed
# when the SERVER cannot open a TLS connection to router.huggingface.co while
# the teacher's browser can ("FLUX gateway unreachable … fetch failed").
# VITE_HUGGINGFACE_API_KEY=

REPLICATE_API_TOKEN=

# Vercel Web Analytics — set to "true" ONLY after enabling Web Analytics for
# the Vercel project. While it is off the app never injects
# /_vercel/insights/script.js, so the console stays free of the
# "Failed to load script … Be sure to enable Web Analytics for your project"
# error on deployments that do not use it.
VITE_VERCEL_ANALYTICS=false

# Web Push (VAPID) — enables push notifications IN THE BROWSER / installed PWA.
# Generate a pair with:
#   npx web-push generate-vapid-keys
# When unset, /api/notifications/vapid-public-key reports { enabled: false }
# and the client NotificationManager stays silent (no 404s, no errors).
# NOTE: this path can never reach the Android APK — a Capacitor WebView has no
# PushManager. Use the FCM variables below for the native app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.tld

# Firebase Cloud Messaging — enables push notifications for the ANDROID APK
# (and iOS builds). Provide the service-account JSON of a key that has the
# "Firebase Cloud Messaging" role. Either variable works; the inline one wins.
#   FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"…",
#     "private_key_id":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…",
#     "client_email":"firebase-adminsdk-xxxx@….iam.gserviceaccount.com",…}'
#   GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-adminsdk.json
# When both are unset, /api/notifications/fcm/* answer { enabled: false } and
# the app still shows on-device notifications for anything it observes itself.
# See ANDROID_PUSH_SETUP.md.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

# Absolute base URL of this Express API, e.g. https://eduai.example.com
# Only needed by a NATIVE build: the APK serves its own bundle from the WebView,
# so a relative /api/... request has no server behind it. Web/PWA builds leave
# this empty and use same-origin relative paths. Without it the APK registers
# its FCM token in Firestore (push_tokens) only — which the server reads back
# over the Firestore REST API, so delivery still works.
VITE_API_BASE_URL=
